---
import Base from './Base.astro';
import type { NavKey } from '../data/site';

interface Props {
  title?: string | null;
  heading?: string;
  sub?: string;
  description?: string;
  nav?: NavKey;
  ogImage?: string;
  noindex?: boolean;
  margin?: { no: string; label: string }[];
}

const { title, heading, sub, description, nav = 'home', ogImage, noindex, margin = [] } = Astro.props;
---

<Base title={title} description={description} nav={nav} ogImage={ogImage} noindex={noindex}>
  {heading && (
    <header style="margin-bottom:2rem">
      <div class="sec-label">§ {heading}</div>
      <h1 style="font-size:clamp(2rem,5vw,2.8rem)">{heading}</h1>
      {sub && <div style="color:var(--muted);font-family:var(--font-mono);font-size:0.85rem" set:html={sub} />}
    </header>
  )}
  {margin.length > 0 ? (
    <div class="with-margin">
      <aside class="margin-col" aria-label="Section contents">
        {margin.map((m) => <div><span class="sec-no">{m.no}</span> {m.label}</div>)}
        <slot name="margin" />
      </aside>
      <div class="prose"><slot /></div>
    </div>
  ) : (
    <div class="prose" style="max-width:var(--measure)"><slot /></div>
  )}
</Base>
