---
import { site, navItems, type NavKey } from '../data/site';

interface Props {
  title?: string | null;
  description?: string;
  nav?: NavKey | null;
  math?: boolean;
  type?: 'website' | 'article';
}

const { title = null, description = site.description, nav = null, math = false, type = 'website' } = Astro.props;
const pageTitle = title ? `${title} - ${site.title}` : site.title;
const canonical = new URL(Astro.url.pathname, site.url).href;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {math && <link rel="stylesheet" href="/katex.css" />}
  </head>
  <body>
    <header>
      <a href="/"><b>{site.title}</b></a>
      <nav aria-label="Site">
        {navItems.map((item, i) => (
          <>{i > 0 && ' | '}<a href={item.href} aria-current={nav === item.key ? 'page' : undefined}>{item.label}</a></>
        ))}
      </nav>
      <hr />
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <hr />
      <p>
        &copy; {year} {site.author} |
        <a href={`mailto:${site.email}`}>email</a> |
        <a href={site.github}>github</a> |
        <a href="/rss.xml">rss</a> |
        <a href="/research.bib">bibtex</a>
      </p>
    </footer>
  </body>
</html>
