---
import Serpent from './ornaments/Serpent.astro';

interface Props {
  title: string;
  sub?: string;
  kanji?: string;
}
const { title, sub, kanji } = Astro.props;
---
<header class="page-head">
  <h1>{kanji && <span class="seal" aria-hidden="true">{kanji}</span>}{title}</h1>
  {sub && <p class="page-sub">{sub}</p>}
  <Serpent />
</header>
