---
import { site } from '../data/site';

interface Props {
  active?: 'home' | 'blog' | 'projects' | 'research' | 'writings';
}

const { active = 'home' } = Astro.props;
---

<nav class="nav-inner">
  <a class="brand" href="/">{site.brand}</a>
  <div class="nav-links" id="navLinks">
    <a href="/" {...(active === 'home' ? { class: 'active' } : {})}>home</a>
    <a href="/blog/" {...(active === 'blog' ? { class: 'active' } : {})}>blog</a>
    <a href="/projects/" {...(active === 'projects' ? { class: 'active' } : {})}>projects</a>
    <a href="/research/" {...(active === 'research' ? { class: 'active' } : {})}>research</a>
    <a href="/writings/" {...(active === 'writings' ? { class: 'active' } : {})}>writings</a>
    <a href={site.github} target="_blank" rel="noopener">github</a>
  </div>
  <button class="theme-btn" id="themeToggle" type="button" aria-label="Toggle dark mode">
    <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg>
    <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.4 1.4M17.2 17.2 18.6 18.6M18.6 5.4 17.2 6.8M6.8 17.2 5.4 18.6"/></svg>
  </button>
  <button class="nav-toggle" id="navToggle" type="button" aria-label="Toggle navigation" aria-expanded="false">☰</button>
</nav>
