---
/* Instruction-word navigation: 32-bit RISC-V R-type bit-field. Pure CSS look over a plain nav+ul. */
import type { NavKey } from '../data/site';

interface Props { active?: NavKey; }
const { active = 'home' } = Astro.props;

type Field = { key: string; field: string; label: string; bits: string; href: string; mnemonic: string; match: NavKey[] };
const word: Field[] = [
  { key: 'about', field: 'funct7', label: 'about', bits: '0000000', href: '/', mnemonic: 'LOAD about', match: ['home', 'colophon'] },
  { key: 'blog', field: 'rs2', label: 'blog', bits: '00001', href: '/blog/', mnemonic: 'LOAD blog', match: ['blog'] },
  { key: 'projects', field: 'rs1', label: 'projects', bits: '00010', href: '/projects/', mnemonic: 'LOAD projects', match: ['projects'] },
  { key: 'research', field: 'funct3', label: 'research', bits: '011', href: '/research/', mnemonic: 'LOAD research', match: ['research'] },
  { key: 'writings', field: 'rd', label: 'writings', bits: '00100', href: '/writings/', mnemonic: 'LOAD writings', match: ['writings'] },
  { key: 'github', field: 'opcode', label: 'github', bits: '0001011', href: 'https://github.com/vajradevam', mnemonic: 'JAL github', match: [] },
];
const currentFor = (f: Field): boolean => f.match.includes(active);
const shownBits = (f: Field): string => (currentFor(f) ? f.bits.replaceAll('0', '1') : f.bits);
---

<div class="doc-head" role="banner">
  <div class="doc-bar">
    <span class="doc-no">VAJRADEVAM-01</span>
    <span>Personal Datasheet · Rev 2026.10</span>
    <span class="spacer"></span>
    <span>Sheet 1 of 1</span>
  </div>
</div>
<nav class="instr-nav" aria-label="Primary">
  <div class="instr-inner">
    <div class="instr-title"><a class="brand" href="/">vajradevam</a><span>· instruction-word navigation · Aman Pathak</span></div>
    <ul class="instr-word" id="instrWord">
      {word.map((f) => (
        <li data-field={f.field} data-bits={f.bits} aria-current={currentFor(f) ? 'page' : undefined}>
          <a href={f.href} {...(f.key === 'github' ? { target: '_blank', rel: 'noopener' } : {})}>
            <span class="f-name">{f.field} · {f.bits.length}b</span>
            <span class="f-link">{f.label}</span>
            <span class="f-bits" aria-hidden="true">{shownBits(f)}</span>
            <span class="f-mnemonic" aria-hidden="true">{f.mnemonic}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>
