---
interface Props {
  caption?: string;
  headers: string[];
  responsive?: boolean;
}
const { caption, headers, responsive = true } = Astro.props;
---

<table class:list={['spec', responsive && 'responsive']}>
  {caption && <caption>{caption}</caption>}
  <thead><tr>{headers.map((h) => <th scope="col">{h}</th>)}</tr></thead>
  <tbody><slot /></tbody>
</table>
