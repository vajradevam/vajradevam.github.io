---
// Himalayan horizon above the footer. Decorative only.
---
<div class="peaks" aria-hidden="true">
  <svg viewBox="0 0 1440 110" preserveAspectRatio="none">
    <!-- haze ridge, barely there -->
    <path
      d="M0 88 L120 70 L240 86 L380 56 L500 80 L640 62 L760 84 L900 58 L1040 82 L1180 64 L1320 84 L1440 72 L1440 110 L0 110 Z"
      fill="var(--peak-haze)"
    />
    <!-- far ridge -->
    <path
      d="M0 95 L90 62 L170 84 L280 38 L350 70 L470 50 L560 78 L690 28 L780 66 L900 46 L1010 80 L1120 40 L1230 72 L1330 54 L1440 86 L1440 110 L0 110 Z"
      fill="var(--peak-far)"
    />
    <!-- near ridge -->
    <path
      d="M0 110 L60 88 L180 56 L260 84 L390 42 L480 80 L620 54 L740 92 L860 50 L960 86 L1100 58 L1210 92 L1320 70 L1440 96 L1440 110 Z"
      fill="var(--peak-near)"
    />
    <!-- snow caps -->
    <g fill="var(--peak-snow)">
      <path d="M280 38 L305 49 L292 52 L270 47 Z" />
      <path d="M690 28 L716 40 L702 44 L678 38 Z" />
      <path d="M1120 40 L1144 50 L1130 54 L1108 48 Z" />
      <path d="M390 42 L412 52 L399 55 L378 50 Z" />
      <path d="M860 50 L880 59 L868 62 L849 57 Z" />
    </g>
  </svg>
</div>
