---
// A golden naga as a section divider. Decorative only.
---
<div class="serpent" aria-hidden="true">
  <svg viewBox="0 0 720 30" preserveAspectRatio="xMidYMid meet" fill="none">
    <!-- tail curl -->
    <path d="M14 15 c -6 -5 -6 -9 1 -9 c 6 0 6 7 -1 9" stroke="var(--gold-deco)" stroke-width="1.4" />
    <!-- body -->
    <path
      d="M14 15 Q 52 3 90 15 T 166 15 T 242 15 T 318 15 T 394 15 T 470 15 T 546 15 T 622 15 Q 650 24 672 15"
      stroke="var(--gold-deco)" stroke-width="1.6" stroke-linecap="round"
    />
    <!-- dorsal glints -->
    <g stroke="var(--gold-deco)" stroke-width="1" opacity="0.55">
      <path d="M90 15 v -4" /><path d="M166 15 v 4" /><path d="M242 15 v -4" />
      <path d="M318 15 v 4" /><path d="M394 15 v -4" /><path d="M470 15 v 4" /><path d="M546 15 v -4" />
    </g>
    <!-- head -->
    <path d="M672 15 q 10 -7 22 -1 q -8 9 -22 1 z" fill="var(--gold-deco)" />
    <circle cx="684" cy="13.5" r="1.3" fill="var(--accent)" />
    <!-- forked tongue -->
    <path d="M694 14 q 7 0 10 -3 M694 14 q 7 2 10 5" stroke="var(--accent)" stroke-width="1" stroke-linecap="round" />
  </svg>
</div>
