---
// Decorative PCB-trace artwork for the hero. Pure SVG, animated with CSS
// (stroke draw-in) and SVG animateMotion (signal pulses). Hidden from AT.
---
<div class="circuit" aria-hidden="true">
  <svg viewBox="0 0 640 560" preserveAspectRatio="xMaxYMid slice">
    <!-- die -->
    <rect class="die" x="420" y="200" width="100" height="100" rx="4" />
    <rect class="die" x="438" y="218" width="64" height="64" rx="2" style="opacity:.5" />

    <!-- traces: 45-degree PCB routing out of the die -->
    <path class="trace lit" d="M420 220 H340 L295 175 H150" style="animation-delay:.1s" />
    <path class="trace"     d="M420 245 H320 L265 300 H120" style="animation-delay:.3s" />
    <path class="trace lit" d="M420 270 H350 L290 330 V430" style="animation-delay:.5s" />
    <path class="trace"     d="M445 300 V350 L395 400 H250" style="animation-delay:.6s" />
    <path class="trace"     d="M475 300 V370 L530 425 V530" style="animation-delay:.7s" />
    <path class="trace lit" d="M500 300 V390 L560 450 H640" style="animation-delay:.8s" />
    <path class="trace"     d="M445 200 V140 L395 90 H270"  style="animation-delay:.4s" />
    <path class="trace lit" d="M475 200 V120 L525 70 V-10"  style="animation-delay:.2s" />
    <path class="trace"     d="M500 200 V150 L555 95 H640"  style="animation-delay:.9s" />
    <path class="trace"     d="M520 230 H580 L640 170"      style="animation-delay:1s" />
    <path class="trace lit" d="M520 275 H600 L640 315"      style="animation-delay:1.1s" />

    <!-- pads at trace terminals -->
    <circle class="pad lit" cx="150" cy="175" r="5" />
    <circle class="pad"     cx="120" cy="300" r="5" />
    <circle class="pad lit" cx="290" cy="430" r="5" />
    <circle class="pad"     cx="250" cy="400" r="5" />
    <circle class="pad"     cx="270" cy="90"  r="5" />
    <circle class="pad"     cx="530" cy="530" r="5" />

    <!-- signal pulses travelling along lit nets -->
    <g class="pulses">
      <circle class="pulse" r="3">
        <animateMotion dur="5s" repeatCount="indefinite" path="M420 220 H340 L295 175 H150" />
      </circle>
      <circle class="pulse" r="3">
        <animateMotion dur="6.5s" begin="1.6s" repeatCount="indefinite" path="M420 270 H350 L290 330 V430" />
      </circle>
      <circle class="pulse" r="3">
        <animateMotion dur="7s" begin="3s" repeatCount="indefinite" path="M500 300 V390 L560 450 H640" />
      </circle>
    </g>
  </svg>
</div>

<style>
  @media (prefers-reduced-motion: reduce) {
    .pulses { display: none; }
  }
</style>
