---
// White tiger crest with a golden cape; 王 ("king") marks the forehead,
// as in traditional Himalayan and East Asian tiger art. Decorative only.
---
<div class="tiger" aria-hidden="true">
  <svg viewBox="0 0 120 120">
    <!-- golden cape, rayed like a sun halo -->
    <g fill="var(--gold-deco)">
      <circle cx="60" cy="60" r="46" opacity="0.92" />
      <g opacity="0.92">
        <path d="M60 4 L66 16 L54 16 Z" />
        <path d="M60 116 L66 104 L54 104 Z" />
        <path d="M4 60 L16 54 L16 66 Z" />
        <path d="M116 60 L104 54 L104 66 Z" />
        <path d="M20 20 L31 24 L24 31 Z" />
        <path d="M100 20 L96 31 L89 24 Z" />
        <path d="M20 100 L24 89 L31 96 Z" />
        <path d="M100 100 L89 96 L96 89 Z" />
      </g>
      <circle cx="60" cy="60" r="41" fill="none" stroke="var(--accent)" stroke-width="1.2" opacity="0.6" />
    </g>
    <!-- ears -->
    <circle cx="38" cy="36" r="11" fill="#fdfbf4" stroke="var(--ink-deco)" stroke-width="1.6" />
    <circle cx="82" cy="36" r="11" fill="#fdfbf4" stroke="var(--ink-deco)" stroke-width="1.6" />
    <circle cx="38" cy="36" r="5" fill="var(--gold-deco)" />
    <circle cx="82" cy="36" r="5" fill="var(--gold-deco)" />
    <!-- face -->
    <ellipse cx="60" cy="64" rx="31" ry="29" fill="#fdfbf4" stroke="var(--ink-deco)" stroke-width="1.8" />
    <!-- forehead mark: king -->
    <text x="60" y="52" text-anchor="middle" font-size="13" fill="var(--ink-deco)" font-family="serif" font-weight="bold">王</text>
    <!-- cheek stripes -->
    <g fill="var(--ink-deco)">
      <path d="M31 58 q 8 1 12 4 q -7 2 -12 1 z" />
      <path d="M31 67 q 8 0 12 3 q -7 2 -12 1 z" />
      <path d="M89 58 q -8 1 -12 4 q 7 2 12 1 z" />
      <path d="M89 67 q -8 0 -12 3 q 7 2 12 1 z" />
    </g>
    <!-- eyes -->
    <g>
      <path d="M44 61 q 5 -4 10 0 q -5 4 -10 0 z" fill="var(--ink-deco)" />
      <path d="M66 61 q 5 -4 10 0 q -5 4 -10 0 z" fill="var(--ink-deco)" />
      <circle cx="49" cy="61" r="1.4" fill="var(--gold-deco)" />
      <circle cx="71" cy="61" r="1.4" fill="var(--gold-deco)" />
    </g>
    <!-- nose and mouth -->
    <path d="M56 71 h 8 l -4 5 z" fill="var(--accent)" />
    <path d="M60 76 v 4 M60 80 q -5 5 -10 2 M60 80 q 5 5 10 2" stroke="var(--ink-deco)" stroke-width="1.4" fill="none" stroke-linecap="round" />
    <!-- whiskers -->
    <g stroke="var(--ink-deco)" stroke-width="0.9" opacity="0.7" stroke-linecap="round">
      <path d="M34 74 q -8 -1 -13 -4" /><path d="M34 78 q -8 1 -13 3" />
      <path d="M86 74 q 8 -1 13 -4" /><path d="M86 78 q 8 1 13 3" />
    </g>
  </svg>
</div>
