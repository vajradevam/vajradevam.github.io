---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import fs from 'node:fs';
import path from 'node:path';

function titleFromName(name: string): string {
  return name.replace(/\.pdf$/i, '').replace(/[-_]/g, ' ').replace(/\s+/g, ' ').trim();
}
function fmtSize(bytes: number): string {
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(0)} KB`;
  return `${(bytes / 1024 / 1024).toFixed(1)} MB`;
}

const writingsDir = path.join(process.cwd(), 'public', 'writings');
let writings: { file: string; title: string; size: string }[] = [];
try {
  writings = fs
    .readdirSync(writingsDir)
    .filter((f) => f.toLowerCase().endsWith('.pdf'))
    .sort((a, b) => a.localeCompare(b))
    .map((file) => ({
      file,
      title: titleFromName(file),
      size: fmtSize(fs.statSync(path.join(writingsDir, file)).size),
    }));
} catch {
  writings = [];
}
---

<Base nav="writings" title="Writings" description="Longer writings by Aman Pathak — systems, theses, essays, as PDFs.">
  <div class="wrap">
    <PageHead
      label="library"
      addr="0x0500"
      title="Writings"
      sub={`Longer-form work, typeset and shelved — ${writings.length} volume${writings.length !== 1 ? 's' : ''}. New PDFs dropped into public/writings/ appear here at build time.`}
    />

    <div class="shelf">
      {writings.map((w, i) => (
        <article class="spine xh" aria-label={`${w.title}, PDF, ${w.size}`}>
          <div class="smeta">VOL. {String(i + 1).padStart(2, '0')} · PDF · {w.size}</div>
          <div class="stitle">{w.title}</div>
          <a href={`/writings/${encodeURIComponent(w.file)}`} target="_blank" rel="noopener">open pdf ↗</a>
        </article>
      ))}
    </div>
  </div>
</Base>
