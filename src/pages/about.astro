---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import skills from '../data/skills.json';
import experience from '../data/experience.json';
---

<Base nav="about" title="About" description="About Aman Pathak: PhD scholar in hardware security and computer architecture at BITS Pilani Goa.">
  <h1>About</h1>

  <h2>Experience</h2>
  {experience.map((e) => (
    <>
      <h3>{e.role} <small>({e.date})</small></h3>
      <p>{e.org}</p>
      <ul>
        {e.bullets.map((b) => <li>{b}</li>)}
      </ul>
    </>
  ))}

  <h2>Skills</h2>
  <table border="1" cellpadding="8" cellspacing="0" width="100%">
    <tbody>
      {skills.map((group) => (
        <tr valign="top"><th scope="row" align="left" width="20%">{group.label}</th><td>{group.items.join(', ')}</td></tr>
      ))}
    </tbody>
  </table>

  <h2>Contact</h2>
  <table border="1" cellpadding="8" cellspacing="0" width="100%">
    <tbody>
      <tr valign="top"><th scope="row" align="left" width="20%">Email</th><td><a href={`mailto:${site.email}`}>{site.email}</a></td></tr>
      <tr valign="top"><th scope="row" align="left" width="20%">GitHub</th><td><a href={site.github}>github.com/vajradevam</a></td></tr>
      <tr valign="top"><th scope="row" align="left" width="20%">Web</th><td><a href="/">vajradevam.in</a></td></tr>
      <tr valign="top"><th scope="row" align="left" width="20%">RSS</th><td><a href="/rss.xml">/rss.xml</a></td></tr>
    </tbody>
  </table>
</Base>
