---
import Page from '../layouts/Page.astro';
import Tag from '../components/Tag.astro';
import { getSortedPosts, getAllTags, formatDate } from '../lib/posts';

const posts = await getSortedPosts();
const tags = await getAllTags();

const postsByTag = new Map<string, typeof posts>();
for (const { tag } of tags) {
  postsByTag.set(tag, posts.filter((p) => (p.data.tags ?? []).includes(tag)));
}
---

<Page nav="blog" title="Tags" heading="Tags" sub="Index of topics. Anchors (#tag) from the old site keep working.">
  <div class="controls" style="font-size:0.85rem">
    {tags.map(({ tag }) => <Tag tag={tag} />)}
  </div>
  {tags.map(({ tag, count }) => (
    <section id={tag.toLowerCase().replace(/[^a-z0-9]+/g, '-')} aria-label={`Posts tagged ${tag}`}>
      <h2 class="year-rule">#{tag} · {count}</h2>
      {(postsByTag.get(tag) ?? []).map((post) => (
        <div class="entry">
          <span class="eno"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time></span>
          <div>
            <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
            {post.data.description && <p class="esummary">{post.data.description}</p>}
          </div>
        </div>
      ))}
    </section>
  ))}
</Page>
