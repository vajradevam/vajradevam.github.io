---
import Base from '../layouts/Base.astro';
import projects from '../data/projects.json';

const catNames: Record<string, string> = {
  systems: 'Systems',
  hardware: 'Hardware and security',
  web: 'Web and backends',
  emulators: 'Emulators',
  ml: 'Machine learning',
  games: 'Games',
  frontend: 'Frontend',
  compilers: 'Compilers and languages',
  misc: 'Tools and miscellany',
  coursework: 'Coursework and puzzles',
  forks: 'Forks',
};
const cats = Object.keys(catNames).filter((c) => projects.some((p) => p.category === c));
---

<Base nav="projects" title="Projects" description={`${projects.length} projects by Aman Pathak: systems programming in C, emulators, compilers, ML, and web, mostly built from scratch.`}>
  <h1>Projects</h1>
  <p>{projects.length} projects, mostly built from scratch. Every public repository on GitHub, forks included.</p>

  <p>
    {cats.map((c, i) => (
      <>{i > 0 && ' | '}<a href={`#${c}`}>{catNames[c] ?? c}</a></>
    ))}
  </p>

  {cats.map((c) => (
    <>
      <h2 id={c}>{catNames[c] ?? c} ({projects.filter((p) => p.category === c).length})</h2>
      <table border="1" cellpadding="8" cellspacing="0" width="100%">
        <thead><tr><th align="left">Project</th><th align="left">Description</th><th align="left">Language</th></tr></thead>
        <tbody>
          {projects.filter((p) => p.category === c).map((p) => (
            <tr valign="top"><td><a href={p.repo}>{p.name}</a></td><td>{p.description}</td><td>{p.lang}</td></tr>
          ))}
        </tbody>
      </table>
    </>
  ))}
</Base>
