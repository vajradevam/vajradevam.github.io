---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import projects from '../data/projects.json';

const categories = [...new Set(projects.map((p) => p.category))];
const sorted = [...projects].sort((a, b) => Number(b.featured) - Number(a.featured));
---

<Base nav="projects" title="Projects" description={`${projects.length} projects by Aman Pathak — systems programming in C, emulators, compilers, ML, and web, most of them built from scratch.`}>
  <div class="wrap">
    <PageHead
      label="projects"
      addr="0x0300"
      title="Projects"
      sub={`${projects.length} entries on record — TCP/IP stacks, allocators, emulators, VMs, compilers. “From scratch” is the recurring theme. All code on GitHub.`}
    />

    <div class="filterbar" role="group" aria-label="Filter projects by category">
      <button data-cat="all" aria-pressed="true">all · {projects.length}</button>
      {categories.map((c) => (
        <button data-cat={c} aria-pressed="false">{c} · {projects.filter((p) => p.category === c).length}</button>
      ))}
    </div>

    <div class="proj-grid" id="projGrid">
      {sorted.map((p) => (
        <article class="proj" data-cat={p.category}>
          <div class="top">
            <h3><a href={p.repo} target="_blank" rel="noopener">{p.name}</a></h3>
            <span class="ref">{p.ref}</span>
          </div>
          <p>{p.description || '—'}</p>
          <div class="foot">
            <span class="lang">{p.lang}</span>
            {p.featured && <span class="badge hot" style="position:relative;z-index:1">featured</span>}
            <span class="star">{p.category}</span>
          </div>
        </article>
      ))}
    </div>
  </div>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filterbar button');
    const cards = document.querySelectorAll<HTMLElement>('#projGrid .proj');

    function apply(cat: string) {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.cat === cat)));
      cards.forEach((c) => {
        c.style.display = cat === 'all' || c.dataset.cat === cat ? '' : 'none';
      });
    }

    buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.cat ?? 'all')));

    // Deep-linking: /projects/#systems preselects that category.
    const hash = location.hash.slice(1);
    if (hash && [...buttons].some((b) => b.dataset.cat === hash)) apply(hash);
  </script>
</Base>
