---
import Base from '../../layouts/Base.astro';
import { getSortedPosts, formatDate } from '../../lib/posts';

const posts = await getSortedPosts();
---

<Base nav="blog" title="Blog" description="Blog of Aman Pathak: posts on computer architecture, the Linux kernel, C, compilers.">
  <h1>Blog</h1>
  <p>{posts.length} posts on architecture, kernels, C, and compilers. <a href="/rss.xml">RSS</a>.</p>

  <table border="1" cellpadding="8" cellspacing="0" width="100%">
    <thead><tr><th align="left">Date</th><th align="left">Post</th><th align="left">Tags</th></tr></thead>
    <tbody>
      {posts.map((post) => (
        <tr valign="top">
          <td><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time></td>
          <td>
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            {post.data.description && <><br />{post.data.description}</>}
          </td>
          <td>{post.data.tags.join(', ')}</td>
        </tr>
      ))}
    </tbody>
  </table>
</Base>
