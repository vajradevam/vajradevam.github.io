---
import Page from '../../layouts/Page.astro';
import Tag from '../../components/Tag.astro';
import { getSortedPosts, getAllTags, formatDate, slugify, searchableText } from '../../lib/posts';

const posts = await getSortedPosts();
const tags = await getAllTags();

const postsByYear = posts.reduce<Record<string, typeof posts>>((acc, post) => {
  const year = String(post.data.pubDate.getFullYear());
  (acc[year] ??= []).push(post);
  return acc;
}, {});
const years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));

// Global entry numbers: #001 = oldest.
const chrono = [...posts].reverse();
const numbers = new Map<string, string>();
chrono.forEach((p, i) => numbers.set(p.id, '#' + String(i + 1).padStart(3, '0')));

const index = posts.map((p) => ({
  id: p.id,
  title: p.data.title,
  desc: (p.data.description ?? '').toLowerCase(),
  tags: (p.data.tags ?? []).map((t) => t.toLowerCase()),
  hay: searchableText(p),
}));
---

<Page
  nav="blog"
  title="Blog"
  heading="Blog"
  sub="Numbered journal · writing on hardware, compilers, C, and low-level systems."
  description="Posts on computer architecture, hardware security, compilers, C, and low-level systems."
  ogImage="/og/blog.png"
>
  <div class="controls">
    <input type="search" id="blogSearch" placeholder="search title, tag, or keyword…" aria-label="Search posts" autocomplete="off" />
    <select id="tagFilter" aria-label="Filter by tag">
      <option value="">Tag · all</option>
      {tags.map(({ tag, count }) => <option value={tag.toLowerCase()}>{tag} ({count})</option>)}
    </select>
  </div>
  <p class="sec-label" id="postCount" aria-live="polite">{posts.length} entries</p>

  <script id="post-index" type="application/json" set:html={JSON.stringify(index)} />

  <div id="blogList">
    {years.map((year) => (
      <section data-year={year}>
        <h2 class="year-rule">{year}</h2>
        {postsByYear[year].map((post) => (
          <article class="entry" data-id={post.id} data-hay={searchableText(post)}>
            <span class="eno">{numbers.get(post.id)}</span>
            <div>
              <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
              <div class="edate"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time></div>
              {post.data.description && <p class="esummary">{post.data.description}</p>}
              {(post.data.tags?.length ?? 0) > 0 && (
                <div>{post.data.tags.map((tag, i) => <span>{i > 0 ? ' ' : ''}<Tag tag={tag} /></span>)}</div>
              )}
            </div>
          </article>
        ))}
      </section>
    ))}
  </div>
  <p class="empty-note" id="blogEmpty">no entries match your search</p>

  <script>
    import '../../scripts/blog.ts';
  </script>
</Page>
