---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { getSortedPosts, formatDate } from '../../lib/posts';

const posts = await getSortedPosts();
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<Base nav="blog" title="Blog" description="Journal of Aman Pathak — posts on computer architecture, the Linux kernel, C, compilers, and the occasional 3 a.m. thought.">
  <div class="wrap-narrow">
    <PageHead
      label="journal"
      addr="0x0400"
      title="Blog"
      sub={`${posts.length} entries — architecture, kernels, C, compilers, and the occasional 3 a.m. thought. Also available as an RSS feed.`}
    />

    <div class="filterbar" role="group" aria-label="Filter posts by tag">
      <button data-tag="all" aria-pressed="true">all</button>
      {tags.map((t) => <button data-tag={t} aria-pressed="false">#{t}</button>)}
    </div>

    <div id="entries" style="margin-top:1.5rem">
      {posts.map((post) => (
        <article class="entry" data-tags={post.data.tags.join(' ')}>
          <span class="eno"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time></span>
          <div>
            <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
            {post.data.description && <p class="esummary">{post.data.description}</p>}
            <div class="etags">{post.data.tags.map((t) => <span class="chip">#{t}</span>)}</div>
          </div>
        </article>
      ))}
    </div>
  </div>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filterbar button');
    const entries = document.querySelectorAll<HTMLElement>('#entries .entry');
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const tag = b.dataset.tag ?? 'all';
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        entries.forEach((e) => {
          const tags = (e.dataset.tags ?? '').split(' ');
          e.style.display = tag === 'all' || tags.includes(tag) ? '' : 'none';
        });
      })
    );
  </script>
</Base>
