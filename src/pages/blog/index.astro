---
import Page from '../../layouts/Page.astro';
import { getSortedPosts, getAllTags, formatDate, slugify, searchableText } from '../../lib/posts';

const posts = await getSortedPosts();
const tags = await getAllTags();

const postsByYear = posts.reduce<Record<string, typeof posts>>((acc, post) => {
  const year = String(post.data.pubDate.getFullYear());
  (acc[year] ??= []).push(post);
  return acc;
}, {});
const years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));
---

<Page
  nav="blog"
  title="Blog"
  heading="Blog"
  sub="Writing, musing, and all things close to the metal."
  description="Posts on computer architecture, hardware security, compilers, C, and low-level systems."
>
  <div class="search-bar">
    <input type="text" id="blogSearch" placeholder="search posts by title, tag, or keyword…" autocomplete="off" />
  </div>

  {tags.length > 0 && (
    <div class="tag-cloud">
      {tags.map(({ tag }) => (
        <a class="tag" href={`/tags/#${slugify(tag)}`}>#{tag}</a>
      ))}
    </div>
  )}

  {posts.length === 0 ? (
    <p class="gh-loading">No posts yet, check back soon.</p>
  ) : (
    <>
      <div id="blogList">
        {years.map((year) => (
          <div class="year-group">
            <h2 class="year">{year}</h2>
            {postsByYear[year].map((post) => (
              <div class="post-entry" data-search={searchableText(post)}>
                <div class="post-entry-head">
                  <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                  <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                </div>
                {post.data.description && <p class="post-entry-desc">{post.data.description}</p>}
                {(post.data.tags?.length ?? 0) > 0 && (
                  <div class="tags">
                    {post.data.tags.map((tag) => (
                      <a class="tag" href={`/tags/#${slugify(tag)}`}>#{tag}</a>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>
        ))}
      </div>
      <div class="writings-empty" id="blogEmpty"><p>no posts match your search</p></div>
    </>
  )}

  <script is:inline>
    (function () {
      var input = document.getElementById('blogSearch');
      if (!input) return;
      var entries = [].slice.call(document.querySelectorAll('#blogList .post-entry'));
      var groups = [].slice.call(document.querySelectorAll('#blogList .year-group'));
      var empty = document.getElementById('blogEmpty');
      input.addEventListener('input', function () {
        var q = this.value.toLowerCase().trim();
        var anyVisible = false;
        entries.forEach(function (el) {
          var hay = el.getAttribute('data-search') || '';
          var match = !q || hay.indexOf(q) > -1;
          el.style.display = match ? '' : 'none';
          if (match) anyVisible = true;
        });
        groups.forEach(function (g) {
          var hasVisible = false;
          g.querySelectorAll('.post-entry').forEach(function (e) {
            if (e.style.display !== 'none') hasVisible = true;
          });
          g.style.display = hasVisible ? '' : 'none';
        });
        if (empty) empty.style.display = anyVisible ? 'none' : 'block';
      });
    })();
  </script>
</Page>
