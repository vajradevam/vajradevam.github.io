---
import Base from '../layouts/Base.astro';
---

<Base title="404" description="Page not found.">
  <div class="wrap err-wrap">
    <p class="sec-label" style="justify-content:center">exception</p>
    <div class="code">0x194</div>
    <p class="msg">
      SIGSEGV — page fault at this address.<br />
      The pointer you followed is dangling.
    </p>
    <a class="btn solid" href="/">return to reset vector</a>
  </div>
</Base>
