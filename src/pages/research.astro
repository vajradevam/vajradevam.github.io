---
import Page from '../layouts/Page.astro';
import Figure from '../components/Figure.astro';
import experience from '../data/experience.json';
import patents from '../data/patents.json';
import publications from '../data/publications.json';

const statuses = [...new Set(publications.map((p) => p.status))];
const badge = (s: string) => s === 'SCI-Q1' ? 'b-q1' : s === 'SCI-Q2' ? 'b-q2' : /^accepted/i.test(s) ? 'b-acc' : /^under review/i.test(s) ? 'b-rev live' : 'b-scopus';
---

<Page
  nav="research"
  title="Research"
  heading="Research"
  sub="Hardware security · RISC-V · side channels · formal verification"
  description="PhD Scholar - hardware security, RISC-V, formal verification, side-channel attacks, 14 publications, 6 patents."
  ogImage="/og/research.png"
  margin={[{ no: '1', label: 'Experience' }, { no: '2', label: 'Patents' }, { no: '3', label: 'Publications' }]}
>
  <h2 class="sec-head" id="experience">1 · Experience <a class="anchor" href="#experience" aria-label="Link to Experience">§</a></h2>

  <Figure no="1" caption="Appointments as a timing diagram. Rising edge marks start of role; arrowhead marks an ongoing signal.">
    <div class="timing" role="img" aria-label="Timing diagram with three signals: PhD Scholar high from 2026 to present; Undergraduate Researcher high May to August 2025; Undergraduate Researcher high February 2023 to August 2024.">
      <svg viewBox="0 0 720 210" stroke="currentColor" fill="none" stroke-width="1.5" aria-hidden="true">
        <g font-family="JetBrains Mono, monospace" font-size="13" fill="currentColor" stroke="none">
          <text x="60" y="200">2023</text><text x="210" y="200">2024</text>
          <text x="360" y="200">2025</text><text x="510" y="200">2026</text>
          <text x="640" y="200">2027</text>
        </g>
        <g stroke="var(--rule)">
          <line x1="60" y1="10" x2="60" y2="185" /><line x1="210" y1="10" x2="210" y2="185" />
          <line x1="360" y1="10" x2="360" y2="185" /><line x1="510" y1="10" x2="510" y2="185" />
          <line x1="660" y1="10" x2="660" y2="185" />
        </g>
        <g font-family="JetBrains Mono, monospace" font-size="13" fill="currentColor" stroke="none">
          <text x="0" y="45">PhD</text><text x="0" y="105">UR-25</text><text x="0" y="165">UR-23</text>
        </g>
        <!-- PhD 2026.0 -> present -->
        <polyline points="60,50 510,50 510,32 627,32" stroke="var(--h-blue)" />
        <polygon points="627,32 617,28 617,36" fill="var(--h-blue)" stroke="none" />
        <!-- UR May-Aug 2025 -->
        <polyline points="60,110 410,110 410,92 454,92 454,110 660,110" stroke="var(--h-green)" />
        <!-- UR Feb 2023-Aug 2024 -->
        <polyline points="60,170 72,170 72,152 303,152 303,170 660,170" stroke="var(--h-violet)" />
      </svg>
    </div>
  </Figure>

  <table class="spec responsive">
    <caption>Experience record · role, period, organisation.</caption>
    <thead><tr><th scope="col">Role</th><th scope="col">Period</th><th scope="col">Organisation &amp; work</th></tr></thead>
    <tbody>
      {experience.map((item) => (
        <tr>
          <td data-th="Role"><strong>{item.role}</strong></td>
          <td data-th="Period" style="white-space:nowrap">{item.date}</td>
          <td data-th="Organisation & work">{item.org}
            <ul style="margin-top:0.5rem;padding-left:1.2rem">
              {(item.bullets ?? []).map((b) => <li>{b}</li>)}
            </ul>
          </td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2 class="sec-head" id="patents">2 · Patents <a class="anchor" href="#patents" aria-label="Link to Patents">§</a></h2>
  <table class="spec responsive">
    <caption>Table 1 · Patents filed (6).</caption>
    <thead><tr><th scope="col">Short name</th><th scope="col">Application No.</th><th scope="col">Title</th></tr></thead>
    <tbody>
      {patents.map((p) => (
        <tr>
          <td data-th="Short name"><strong>{p.short}</strong></td>
          <td data-th="Application No." class="addr">{p.application}</td>
          <td data-th="Title">{p.title}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2 class="sec-head" id="publications">3 · Publications <a class="anchor" href="#publications" aria-label="Link to Publications">§</a></h2>
  <div class="controls">
    <label for="statusFilter" style="align-self:center">Status</label>
    <select id="statusFilter">
      <option value="">all ({publications.length})</option>
      {statuses.map((s) => <option value={s}>{s}</option>)}
    </select>
    <a href="/research.bib" download style="align-self:center">Download BibTeX</a>
  </div>
  <ol class="ref-list" id="refList">
    {publications.map((pub) => (
      <li data-status={pub.status}>
        <span>
          <span class="rtitle">{pub.title}</span><br />
          <span>{(pub.authors ?? []).map((a, i) => <>{i > 0 ? ', ' : ''}{a === 'A. Pathak' ? <strong>{a}</strong> : <span>{a}</span>}</>)} · {pub.venue}{pub.year ? `, ${pub.year}` : ''}</span>
          {' '}<span class={`badge ${badge(pub.status)}`}>{pub.status}</span>
        </span>
      </li>
    ))}
  </ol>
  <p class="empty-note" id="refEmpty">no publications with this status</p>

  <script>
    import '../scripts/research.ts';
  </script>
</Page>
