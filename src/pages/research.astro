---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import publications from '../data/publications.json';
import patents from '../data/patents.json';
import now from '../data/now.json';

const published = publications.filter((p) => !['under review'].includes(p.status));
const underReview = publications.filter((p) => p.status === 'under review');

function badgeClass(status: string): string {
  if (status === 'under review') return '';
  if (status === 'accepted') return 'live';
  return 'hot';
}

function formatAuthors(authors: string[]): { text: string; me: boolean }[] {
  return authors.map((a) => ({ text: a, me: a === 'A. Pathak' }));
}
---

<Base nav="research" title="Research" description="Publications, patents, and research interests of Aman Pathak — hardware security, RISC-V microarchitecture, side channels, formal verification.">
  <div class="wrap-narrow">
    <PageHead
      label="research"
      addr="0x0200"
      title="Research"
      sub={`${publications.length} publications · ${patents.length} patents filed · hardware security of RISC-V microarchitecture, side channels, memory encryption, and formal verification.`}
    />

    <p style="margin-top:-.5rem">
      <a class="btn" href="/research.bib" download>⤓ research.bib</a>
    </p>

    <section aria-labelledby="pub-head" id="publications">
      <p class="sec-label"><span class="addr">0x0201</span> published &amp; accepted</p>
      <h2 class="sec-head" id="pub-head">Publications</h2>
      {published.map((p) => (
        <article class="pub">
          <div class="pno">[{String(p.n).padStart(2, '0')}]</div>
          <div>
            <h3>{p.url ? <a href={p.url} target="_blank" rel="noopener">{p.title}</a> : p.title}</h3>
            <p class="meta">
              {formatAuthors(p.authors).map((a, i) => (
                <>{i > 0 && ', '}<span class={a.me ? 'me' : ''}>{a.text}</span></>
              ))}
            </p>
            <p class="meta"><span class="venue">{p.venue}</span>{p.year && <> · {p.year}</>}</p>
            <div class="badges">
              <span class={`badge ${badgeClass(p.status)}`}>{p.status}</span>
              {p.indexed && <span class="badge">{p.indexed}</span>}
            </div>
          </div>
        </article>
      ))}
    </section>

    <section aria-labelledby="rev-head" id="under-review">
      <p class="sec-label"><span class="addr">0x0202</span> in the pipeline</p>
      <h2 class="sec-head" id="rev-head">Under review</h2>
      {underReview.map((p) => (
        <article class="pub">
          <div class="pno">[{String(p.n).padStart(2, '0')}]</div>
          <div>
            <h3>{p.url ? <a href={p.url} target="_blank" rel="noopener">{p.title}</a> : p.title}</h3>
            <p class="meta">
              {formatAuthors(p.authors).map((a, i) => (
                <>{i > 0 && ', '}<span class={a.me ? 'me' : ''}>{a.text}</span></>
              ))}
            </p>
            <p class="meta"><span class="venue">{p.venue}</span></p>
            <div class="badges"><span class="badge">under review</span></div>
          </div>
        </article>
      ))}
    </section>

    <section aria-labelledby="pat-head" id="patents">
      <p class="sec-label"><span class="addr">0x0203</span> filed with the patent office</p>
      <h2 class="sec-head" id="pat-head">Patents</h2>
      <table class="spec responsive xh">
        <caption>TABLE 1 — Indian patent applications, all in the RISC-V space.</caption>
        <thead><tr><th scope="col">application</th><th scope="col">codename</th><th scope="col">title</th></tr></thead>
        <tbody>
          {patents.map((p) => (
            <tr>
              <td data-th="application" class="addr">{p.application}</td>
              <td data-th="codename"><span class="badge hot">{p.short}</span></td>
              <td data-th="title">{p.title}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section aria-labelledby="int-head" id="interests">
      <p class="sec-label"><span class="addr">0x0204</span> open problems</p>
      <h2 class="sec-head" id="int-head">Current threads</h2>
      <ul style="list-style:none;padding:0;margin:0;display:grid;gap:.7rem">
        {now.map((item) => (
          <li class="card" style="display:flex;gap:.9rem;align-items:baseline">
            <span class="led" style="position:relative;top:-1px"></span>
            <span style="font-size:.97rem">{item}</span>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>
