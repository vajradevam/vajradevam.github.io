---
import Base from '../layouts/Base.astro';
import publications from '../data/publications.json';
import patents from '../data/patents.json';
import now from '../data/now.json';

const published = publications.filter((p) => p.status !== 'under review');
const underReview = publications.filter((p) => p.status === 'under review');
---

<Base nav="research" title="Research" description="Publications and patents of Aman Pathak: hardware security, RISC-V microarchitecture, side channels, formal verification.">
  <h1>Research</h1>
  <p>{publications.length} publications, {patents.length} patents filed.</p>
  <p>
    Hardware security of RISC-V microarchitecture: side channels, memory encryption,
    and formal verification. BibTeX for everything below: <a href="/research.bib">research.bib</a>.
  </p>

  <h2 id="publications">Publications</h2>
  <ol>
    {published.map((p) => (
      <li>
        {p.url ? <a href={p.url}>{p.title}</a> : p.title}
        <br />{p.authors.map((a, j) => (<>{j > 0 && ', '}{a === 'A. Pathak' ? <b>{a}</b> : a}</>))}
        <br /><i>{p.venue}</i>{p.year && <>, {p.year}</>}
        <br />{p.status}{p.indexed && <>; {p.indexed}</>}
      </li>
    ))}
  </ol>

  <h2 id="under-review">Under review</h2>
  <ol start={published.length + 1}>
    {underReview.map((p) => (
      <li>
        {p.url ? <a href={p.url}>{p.title}</a> : p.title}
        <br />{p.authors.map((a, j) => (<>{j > 0 && ', '}{a === 'A. Pathak' ? <b>{a}</b> : a}</>))}
        <br /><i>{p.venue}</i>
        <br />under review
      </li>
    ))}
  </ol>

  <h2 id="patents">Patents</h2>
  <p>Indian patent applications, all in the RISC-V space.</p>
  <table border="1" cellpadding="8" cellspacing="0" width="100%">
    <thead><tr><th align="left">Application</th><th align="left">Title</th></tr></thead>
    <tbody>
      {patents.map((p) => (
        <tr valign="top"><td>{p.application}</td><td>{p.title}</td></tr>
      ))}
    </tbody>
  </table>

  <h2 id="now">Current work</h2>
  {now.intro.map((t) => <p>{t}</p>)}
  {now.items.map((item) => (
    <>
      <h3>{item.title}</h3>
      {item.text.map((t) => <p>{t}</p>)}
    </>
  ))}
</Base>
